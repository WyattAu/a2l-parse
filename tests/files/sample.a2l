/* ASAP2 description — demo_ecu.a2l
 * Generator: EstateCal 4.2   ASAP2 version 1.6.1
 */

ASAP2_VERSION 1 61
VERSION "1.0.0"
PROJECT_NO demo_42

/begin PROJECT demo_ecu "Demonstration powertrain project — two-ECU harness"

  /begin HEADER "Project header"
    VERSION "1.0.0"
    PROJECT_NO demo_42
  /end HEADER

  /begin MODULE engine "V8 ECU — engine calibration"

    /begin IF_DATA DCM
      {
        DCM {
          static {
            items {
              item { name "eng_load"; }
            }
          }
        }
      }
    /end IF_DATA

    /begin RECORD_LAYOUT RL_VALUE
      FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_CURVE_UWORD
      FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
      NO_AXIS_PTS_X 1
      AXIS_PTS_X 1 UWORD INDEX_INCR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_MAP_UWORD
      FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
      NO_AXIS_PTS_X 1
      NO_AXIS_PTS_Y 1
      AXIS_PTS_X 1 UWORD INDEX_INCR DIRECT
      AXIS_PTS_Y 2 UWORD INDEX_INCR DIRECT
    /end RECORD_LAYOUT

    /begin COMPU_METHOD engine_speed_c "Engine speed conversion" RAT_FUNC
      "%.0f" "1/min" COEFFS 0 1 0 0 0 1
    /end COMPU_METHOD

    /begin COMPU_METHOD rack_lin "Rack position conversion" RAT_FUNC
      "%.4f" "%" COEFFS 0 0.00390625 0 0 0 1
    /end COMPU_METHOD

    /begin COMPU_METHOD temp_lin "Coolant temperature" LINEAR
      "%.1f" "degC" COEFFS_LINEAR 0.75 -48
    /end COMPU_METHOD

    /begin COMPU_METHOD gear_tab "Gear indicator" TABLE
      "%.0f" "-" COMPU_TAB_REF gear_vtab
    /end COMPU_METHOD

    /begin COMPU_METHOD identity_raw "Raw passthrough" IDENTICAL
      "%.0f" "-"
    /end COMPU_METHOD

    /begin COMPU_VTAB gear_vtab "Gear value table"
      DEFAULT_VALUE 0 "N"
      TAB_VERB 1 "1st" 2 "2nd" 3 "3rd" 4 "4th"
    /end COMPU_VTAB

    /begin CHARACTERISTIC eng_load "Engine load request" VALUE 0x720000
      RL_VALUE 0 rack_lin 0.0 100.0
      FORMAT "%.2f"
      ECU_ADDRESS 0x720000
    /end CHARACTERISTIC

    /begin CHARACTERISTIC inj_map "Main injection quantity" MAP 0x721000
      RL_MAP_UWORD 0 rack_lin 0.0 100.0
      EXTENDED_LIMITS 0.0 120.0
      /begin AXIS_DESCR load_axis "Relative load" UWORD 0x729000
        NO_AXIS_PTS 16
        INPUT_QUANTITY eng_load
        MAX_AXIS_POINTS 32
        /begin AXIS_POINTS "predefined axis" READ_ONLY
        /end AXIS_POINTS
      /end AXIS_DESCR
      /begin AXIS_DESCR rpm_axis "Engine speed" UWORD 0x729800
        NO_AXIS_PTS 16
        INPUT_QUANTITY engine_speed
      /end AXIS_DESCR
    /end CHARACTERISTIC

    /begin CHARACTERISTIC boost_curve "Boost pressure target" CURVE 0x723000
      RL_CURVE_UWORD 0 rack_lin 0.0 250.0
      DISPLAY_IDENTIFIER BoostTarget
      /begin AXIS_DESCR rpm_axis "Engine speed" UWORD 0x72A000
        NO_AXIS_PTS 8
        INPUT_QUANTITY engine_speed
      /end AXIS_DESCR
    /end CHARACTERISTIC

    /begin CHARACTERISTIC ecu_id "ECU identification string" ASCII 0x700000
      RL_VALUE 0 identity_raw 0.0 0.0
    /end CHARACTERISTIC

    /begin MEASUREMENT engine_speed "Engine speed" UWORD
      engine_speed_c 0.01 0.0 0.0 8000.0
      ECU_ADDRESS 0x320001
      FORMAT "%.0f"
    /end MEASUREMENT

    /begin MEASUREMENT coolant_temp "Coolant temperature" SBYTE
      temp_lin 1.0 -48.0 -48.0 120.0
      ECU_ADDRESS 0x320100
    /end MEASUREMENT

    /begin MEASUREMENT gear_pos "Gear position" UBYTE
      gear_tab 1.0 0.0 0.0 4.0
      ECU_ADDRESS 0x320200
    /end MEASUREMENT

    /begin MEASUREMENT virtual_power "Derived power (no address)" UWORD
      rack_lin 0.1 0.0 0.0 10000.0
    /end MEASUREMENT

    /begin FUNCTION torque_chain "Torque model outputs"
      DEF_CHARACTERISTIC boost_curve
      IN_MEASUREMENT engine_speed
      LOC_MEASUREMENT virtual_power
    /end FUNCTION

    /begin GROUP calibration_group "Adjustables"
      GROUP_CHARACTERISTIC eng_load inj_map boost_curve
    /end GROUP

  /end MODULE

  /begin MODULE gearbox "Transmission calibration — shared compu methods"

    /begin RECORD_LAYOUT RL_VALUE
      FNC_VALUES 1 UBYTE COLUMN_DIR DIRECT
    /end RECORD_LAYOUT

    /begin COMPU_METHOD rack_lin "Shared rack conversion" RAT_FUNC
      "%.4f" "%" COEFFS 0 0.00390625 0 0 0 1
    /end COMPU_METHOD

    /begin CHARACTERISTIC shift_pressure "Shift pressure" VALUE 0x730000
      RL_VALUE 0 rack_lin 0.0 100.0
    /end CHARACTERISTIC

  /end MODULE

/end PROJECT
